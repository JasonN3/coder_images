FROM quay.io/centos/centos:stream9

# Install basic packages
RUN dnf install -y epel-release && \
    dnf install -y \
      bash \
      bash-color-prompt \
      bash-completion \
      git \
      jq \
      sudo \
      tmux

# Create coder user
RUN useradd coder \
    --create-home \
    --shell=/bin/bash \
    --uid=1000 \
    --user-group && \
    echo "coder ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers.d/nopasswd

# Instructions from https://github.com/theforeman/foreman/blob/develop/developer_docs/foreman_dev_setup.asciidoc

# Enable CRB
RUN dnf config-manager --enable crb

# Enable NodeJS 22
RUN dnf module enable -y nodejs:22
RUN dnf -y install gcc-c++ make git ruby ruby-devel rubygem-bundler \
    libvirt-devel postgresql-devel openssl-devel \
    libxml2-devel libxslt-devel zlib-devel \
    readline-devel systemd-devel tar libcurl-devel nodejs

# Set up PostgreSQL
RUN dnf install -y postgresql-server
RUN install -o postgres -g postgres -d /var/run/postgresql
USER postgres
RUN PGDATA=/var/lib/pgsql/data initdb
RUN pg_ctl -D /var/lib/pgsql/data start && \
    createuser --createdb coder && \
    pg_ctl -D /var/lib/pgsql/data stop

USER coder
WORKDIR /home/coder
# Install Foreman from source
RUN git clone https://github.com/theforeman/foreman.git && \
    cd foreman && \
    cp config/settings.yaml.example config/settings.yaml && \
    cp config/database.yml.example config/database.yml && \
USER root
RUN cd foremane && \
    bundle install && \
    npm install

# Set up database schema
RUN sudo -u postgres pg_ctl -D /var/lib/pgsql/data start && \
    bundle exec rake db:create && \
    bundle exec rake db:migrate && \
    SEED_ADMIN_PASSWORD=admin bundle exec rake db:seed && \
    sudo -u postgres pg_ctl -D /var/lib/pgsql/data stop

# Finalize as coder image
USER coder